# USI engine build (does NOT modify the original src/makefile)
# Usage (MSYS2 MINGW64):
#   cd src
#   mingw32-make -f Makefile.usi usi
#
# If you want to build nshogi automatically first:
#   mingw32-make -f Makefile.usi nshogi usi

CXX ?= clang++

# Keep flags close to the existing src/makefile defaults.
#CXXFLAGS ?= -std=c++2b -I./nshogi/src -mtune=native -march=native -O3
CXXFLAGS ?= -std=c++2b -I./nshogi/src -mtune=native -march=native -O3 -g -fno-omit-frame-pointer

# nshogi build output directory depends on BUILD and CXX (see nshogi/Makefile).
NSHOGI_BUILD ?= release
CXX ?= clang++
NSHOGI_OBJDIR := nshogi/build/release_clang++
LDFLAGS ?= -L./$(NSHOGI_OBJDIR)/lib -lnshogi_static

USI_TARGET ?= engine_suishov1_5.exe
USI_SRCS := \
	engine/usi.cpp \
	engine/search.cpp \
	engine/StatewithNNUE.cpp \
	engine/nn/nnue_nn.cpp \
	model/weights.cpp

.PHONY: usi nshogi clean

usi:
	$(CXX) $(CXXFLAGS) $(USI_SRCS) -o $(USI_TARGET) $(LDFLAGS)

nshogi:
	$(MAKE) -C nshogi libnshogi BUILD=$(NSHOGI_BUILD) AVX2=1 CXX=$(CXX)

clean:
	rm -f $(USI_TARGET)
